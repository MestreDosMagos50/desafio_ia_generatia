# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - DESAFIO FIC_DEV
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para '.env' no mesmo diretório:
#    cp .env.example .env (ou renomeie manualmente)
# 2. Preencha a chave do provedor que você for utilizar.
# 3. NUNCA adicione o arquivo '.env' ao Git nem compartilhe sua chave privada.
# 4. Confira a chave com: python -m src.main --testar-conexao
# ==============================================================================

# Provedor de IA:
#   openai   - padrão do Desafio 02 (gpt-5.6-luna, gpt-5.6-terra, text-embedding-3-small, omni-moderation-latest)
#   simulado - adaptador local sem rede, sem equivalência de qualidade (testes e T12)
#   google   - Gemini legado do Desafio 01 (modos audio e cartaz)
LLM_PROVIDER=openai

# Chave da OpenAI (obtenha em: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sua_chave_openai_aqui

# Opcional: substituem os modelos do bloco llm.openai do config.json
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_ALT_MODEL=gpt-5.6-terra
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Legado do Desafio 01 (só com LLM_PROVIDER=google) ---
# Chave do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Opcional (RF10): token do Hugging Face para gerar a ilustração do cartaz com o modelo
# aberto FLUX.1-schnell (Space oficial, cota gratuita de GPU) quando a cota da API Gemini
# não incluir modelos de imagem. Crie em https://huggingface.co/settings/tokens (tipo "Read").
HF_TOKEN=

# Nível de Log (DEBUG, INFO, WARNING, ERROR). Padrão: WARNING
LOG_LEVEL=WARNING

# Ambiente (desenvolvimento / producao / teste)
ENVIRONMENT=desenvolvimento
